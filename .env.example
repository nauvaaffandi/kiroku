# Kiroku Environment Variables
# Copy to .env and fill in values

# Backend
PORT=8080
DB_PATH=./data/kiroku.db
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4
FX_BASE_CURRENCY=JPY


# 9Router 
NINE_ROUTER_API_KEY=sk-
NINE_ROUTER_URL=http://localhost:20128/v1
NINE_ROUTER_MODEL_COMBO_NAME=main

# OCR.space API
OCR_SPACE_API_KEY=
KIROKU_MOCK_OCR_ENABLED=false

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=nauva_kiroku_bot
TELEGRAM_CHAT_ID=

# Cloudflare Tunnel (prod)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Backup (optional)
BACKUP_PASSPHRASE=

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1

