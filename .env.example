# Frontend environment variables
# Copy this file to .env and fill in your values

# Base URL for the backend API (used as fallback when Upstash is not configured)
VITE_BACKEND_URL=http://localhost:8080/api/v1

# VAPID public key for Web Push notifications (base64url encoded)
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Upstash Redis REST URL for fetching the backend URL dynamically
# Example: https://your-redis.upstash.io
VITE_UPSTASH_URL=

# Upstash Redis REST token for authentication
VITE_FRONTEND_UPSTASH_REDIS_REST_TOKEN=

# Enable Eruda dev tools in mobile browsers (true/false)
VITE_USE_ERUDA=false