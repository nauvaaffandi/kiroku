# Kiroku Backend Environment Variables
# Copy to .env and fill in values

# Backend
PORT=8080
DATA_DIR=./data

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Argon2
ARGON2_TIME=3
ARGON2_MEMORY=65536
ARGON2_THREADS=4

# FX
FX_BASE_CURRENCY=JPY

# 9Router
NINE_ROUTER_API_KEY=
NINE_ROUTER_URL=http://localhost:20128/v1
NINE_ROUTER_MODEL_COMBO_NAME=main

# OCR.space API
OCR_SPACE_API_KEY=
KIROKU_MOCK_OCR_ENABLED=false

# Telegram (currently not actively used in core flow)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=nauva_kiroku_bot
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_ENABLED=true

# Upstash Redis
UPSTASH_REDIS_REST_URL=
BACKEND_UPSTASH_REDIS_REST_TOKEN=

# Backup
BACKUP_PASSPHRASE=
BACKUP_REPO_PATH=backup/kiroku-backup-storage
BACKUP_GIT_TOKEN=
BACKUP_PROVIDERS=
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=6

# VAPID
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Dev
KIROKU_DEV=

# Logging
# LOG_LEVEL: debug | info | warn | error  (default: DEBUG dev, INFO prod)
LOG_LEVEL=INFO
# LOG_FORMAT: console | json              (default: console dev, json prod)
LOG_FORMAT=console
# LOG_RETENTION: log file age in days     (default: 90d, e.g. 30d / 90D)
LOG_RETENTION=90d
# LOG_DIR: directory for log files        (default: logs)
LOG_DIR=logs
# LOG_MAX_SIZE: max size per file in MB   (default: 100)
LOG_MAX_SIZE=100
# LOG_MAX_BACKUPS: rotated files to keep  (default: 10)
LOG_MAX_BACKUPS=10
# LOG_MAX_AGE: retention override days    (default: 90, overrides LOG_RETENTION)
LOG_MAX_AGE=90
# LOG_COMPRESS: gzip rotated files        (default: true)
LOG_COMPRESS=true
